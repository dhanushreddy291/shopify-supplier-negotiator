# --- Trigger.dev ---------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_...

# --- AI (OpenAI-compatible) ----------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
AI_MODEL=gpt-6.1-terra

# --- Resend & email mode -------------------------------------------------
# EMAIL_MODE controls outbound email:
#   mock   (default) - logs emails locally and simulates replies (never sends real mail)
#   resend           - sends real emails via Resend to supplier addresses in src/lib/catalog.ts
EMAIL_MODE=mock
RESEND_API_KEY=
RESEND_INBOX_ID=
PROCUREMENT_FROM_EMAIL=Acme Procurement <procurement@yourdomain.com>
PROCUREMENT_REPLY_TO=
OWNER_EMAIL=owner@yourdomain.com
SUPPLIER_EMAIL_1=
SUPPLIER_EMAIL_2=
SUPPLIER_EMAIL_3=

# --- Shopify (optional; falls back to demo catalog) ----------------------
SHOPIFY_STORE_DOMAIN=acme-coffee.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# --- Store identity ------------------------------------------------------
STORE_NAME=Acme Coffee Works
STORE_ADDRESS=1450 Valencia St, San Francisco, CA 94110

# --- Bulk-replay demo switch (optional) ----------------------------------
DEMO_FAIL_EMAIL_INGESTION=0
